{
  "appId": "local.egglive.desktop",
  "productName": "EggLive",
  "asar": true,
  "compression": "normal",
  "npmRebuild": false,
  "directories": {
    "output": "installers",
    "buildResources": "installer-resources"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "dist/**/*",
    "package.json",
    "node_modules/ws/**/*"
  ],
  "extraFiles": [
    {
      "from": "OBS",
      "to": "OBS",
      "filter": [
        "**/*",
        "!config{,/**/*}"
      ]
    },
    {
      "from": "installer-resources/vc_redist.x64.exe",
      "to": "prerequisites/vc_redist.x64.exe"
    },
    {
      "from": "installer-resources/安装与使用.txt",
      "to": "安装与使用.txt"
    },
    {
      "from": "release/licenses",
      "to": "licenses"
    },
    {
      "from": "release/第三方许可.md",
      "to": "第三方许可.md"
    },
    {
      "from": "LICENSE",
      "to": "EggLive-LICENSE.txt"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/egg.ico",
    "artifactName": "EggLive-Setup-${version}-x64.exe",
    "signAndEditExecutable": true,
    "signExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "EggLive 鸡蛋直播",
    "installerLanguages": [
      "zh_CN",
      "en_US"
    ],
    "language": "2052",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "include": "installer-resources/installer.nsh"
  }
}
